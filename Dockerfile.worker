# Dockerfile.worker

# Stage 1: Use an official Python runtime as a parent image
# Using a specific version ensures reproducibility. 'slim' is a smaller, more secure base.
FROM python:3.9-slim-bullseye

# Set environment variables for Python and pip
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on

# Install system-level dependencies required by your Python libraries
# e.g., ffmpeg for audio processing, build-essential for compiling some packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    pkg-config \
    # Add the FFmpeg development libraries required by the 'av' Python package
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set the working directory inside the container
WORKDIR /app

# Copy the requirements file first. This is a key optimization.
# Docker caches this layer, so it won't reinstall dependencies unless requirements.txt changes.
COPY Backend/requirements.worker.txt ./requirements.txt

# Install Python dependencies
# We should create a clean, minimal requirements.txt for the worker
RUN pip install --no-cache-dir -r requirements.txt

# Now, copy your entire Backend application code into the container
COPY Backend/ .

# Define the command to run when the container starts.
# This is where our worker script comes in.
# For now, we will set a placeholder command. We will create a script to poll SQS later.
CMD ["python", "sqs_worker.py"]